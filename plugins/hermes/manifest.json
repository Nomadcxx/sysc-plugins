{
  "schema": 1,
  "id": "org.sysc.hermes",
  "name": "Hermes Agent",
  "description": "Hermes status, chat, approvals, sessions and models from the bar, for a local or remote bridge.",
  "version": "0.1.1",
  "protocol": {"major": 1, "minor": 27},
  "exec": "bin/sysc-plugin-hermes",
  "capabilities": ["notifications", "panels", "settings", "clipboard-write",
                   "state-read", "state-write", "floating_surfaces"],
  "requires": {"commands": []},
  "services": [{
    "id": "hermes",
    "label": "Hermes",
    "actions": ["open", "new-session", "interrupt", "refresh", "resume-latest",
                "start-gateway", "settings", "launcher-ask"],
    "quick_action": {"label": "Hermes", "icon": "ai-usage", "action": "open"}
  }],
  "widgets": [{"id": "bar", "settings": []}],
  "panels": [
    {"id": "panel", "label": "Hermes", "width": 780, "height": 720,
     "placement": "attached",
     "shortcuts": [
       {"key": "n", "modifiers": ["ctrl"], "node": "new-session"},
       {"key": "r", "modifiers": ["ctrl"], "node": "refresh"}
     ]},
    {"id": "summary", "label": "Hermes summary", "width": 380, "height": 480,
     "placement": "attached"},
    {"id": "menu", "label": "Hermes menu", "width": 260, "height": 300,
     "placement": "attached"},
    {"id": "settings", "label": "Hermes Settings", "width": 640, "height": 720,
     "placement": "attached", "include_settings": true}
  ],
  "settings": [
    {"key": "client_only_mode", "type": "bool", "label": "Client-only mode (remote bridge)", "default": false,
     "description": "Connect to a Hermes bridge on another machine instead of starting one locally. Set host and port to the forwarded address and paste the bridge token."},
    {"key": "bridge_host", "type": "string", "label": "Bridge host", "default": "127.0.0.1",
     "description": "SSH forward endpoint, LAN address or host. Traffic is plain HTTP; use an SSH tunnel across untrusted networks.",
     "visible_when": {"key": "client_only_mode", "equals": true}},
    {"key": "bridge_port", "type": "int", "label": "Bridge port", "default": 19777, "min": 1, "max": 65535,
     "visible_when": {"key": "client_only_mode", "equals": true}},
    {"key": "bridge_token_manual", "type": "string", "label": "Bridge token", "default": "", "secret": true,
     "description": "Token printed by hermes-bridge-serve.sh on the server. Leave empty to use the token file.",
     "visible_when": {"key": "client_only_mode", "equals": true}},
    {"key": "bridge_token_file", "type": "file", "label": "Bridge token file",
     "default": "~/.config/sysc-shell/hermes.token",
     "description": "Used when the pasted token is empty. Keep it mode 0600.",
     "visible_when": {"key": "client_only_mode", "equals": true}},
    {"key": "ssh_target", "type": "string", "label": "SSH target", "default": "",
     "description": "user@host for the Copy SSH command button.",
     "visible_when": {"key": "client_only_mode", "equals": true}},
    {"key": "state_file", "type": "string", "label": "State file",
     "default": "~/.cache/sysc-hermes/state.json",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "hermes_home", "type": "folder", "label": "Hermes home", "default": "~/.hermes",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "hermes_command", "type": "string", "label": "Hermes command", "default": "hermes",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "python_command", "type": "string", "label": "Python command", "default": "python3",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "bridge_script", "type": "file", "label": "Bridge script", "default": "",
     "description": "Blank uses the bundled scripts/hermes_bridge.py.",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "auto_start_bridge", "type": "bool", "label": "Auto-start bridge", "default": true,
     "description": "Start the local bridge when the plugin loads.",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "auto_start_gateway", "type": "bool", "label": "Auto-start gateway", "default": true,
     "description": "Start the Hermes gateway when it is not running.",
     "visible_when": {"key": "client_only_mode", "equals": false}},
    {"key": "status_poll_interval", "type": "int", "label": "Status poll interval (seconds)",
     "default": 30, "min": 5, "max": 300},
    {"key": "hide_when_idle", "type": "bool", "label": "Hide when idle", "default": false,
     "description": "Only show the bar pill when Hermes is active or needs attention."},
    {"key": "show_tool_activity", "type": "bool", "label": "Show tool activity", "default": false,
     "description": "Show tool calls as compact activity lines."},
    {"key": "default_provider", "type": "string", "label": "Default provider", "default": ""},
    {"key": "default_model", "type": "string", "label": "Default model", "default": ""},
    {"key": "connection_label", "type": "string", "label": "Connection label", "default": "Hermes"},
    {"key": "notify_on_approval", "type": "bool", "label": "Notify on approval", "default": true},
    {"key": "notify_on_complete", "type": "bool", "label": "Notify on completion", "default": false,
     "description": "Desktop alert when a turn ends."}
  ]
}
