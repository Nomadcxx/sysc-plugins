{
  "schema": 1,
  "id": "org.sysc.wallpaper-depth",
  "name": "Wallpaper Depth",
  "description": "Generates a depth mask for the current image wallpaper to place foreground scenery over a centred desktop clock.",
  "version": "1.0.0",
  "protocol": {"major": 1, "minor": 7},
  "exec": "bin/sysc-plugin-wallpaper-depth",
  "capabilities": ["panels", "settings", "state", "wallpaper"],
  "requires": {"commands": ["python3"]},
  "services": [{"id": "wallpaper-depth"}],
  "widgets": [{"id": "bar", "settings": []}],
  "panels": [{"id": "panel", "width": 500, "height": 560, "placement": "attached", "include_settings": true}],
  "settings": [
    {"key": "auto_generate", "type": "bool", "label": "Generate on wallpaper change", "default": true},
    {"key": "threshold", "type": "int", "label": "Threshold", "default": 30, "min": 0, "max": 100},
    {"key": "feather", "type": "int", "label": "Feather", "default": 8, "min": 0, "max": 50}
  ]
}
