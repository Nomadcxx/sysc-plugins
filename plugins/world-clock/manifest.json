{
  "schema": 1,
  "id": "org.sysc.world-clock",
  "name": "World Clock",
  "version": "1.0.0",
  "protocol": {"major": 1, "minor": 0},
  "exec": "bin/sysc-plugin-world-clock",
  "capabilities": ["panels", "settings", "state"],
  "requires": {"commands": []},
  "services": [{"id": "world-clock"}],
  "widgets": [{"id": "bar", "settings": []}],
  "panels": [{"id": "panel", "width": 420, "height": 360, "placement": "attached"}],
  "settings": [
    {"key": "hour24", "type": "bool", "label": "24-hour clock", "default": true}
  ]
}
