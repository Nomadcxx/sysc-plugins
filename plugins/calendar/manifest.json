{
  "schema": 1,
  "id": "org.sysc.calendar",
  "name": "Calendar",
  "description": "A read-only EDS calendar with event views, details, and safe actions.",
  "version": "0.3.0",
  "protocol": {
    "major": 1,
    "minor": 8
  },
  "exec": "bin/sysc-plugin-calendar",
  "capabilities": [
    "panels",
    "settings",
    "state",
    "clipboard-write",
    "open-url"
  ],
  "requires": {
    "commands": []
  },
  "services": [
    {
      "id": "calendar"
    }
  ],
  "widgets": [
    {
      "id": "bar",
      "settings": []
    }
  ],
  "panels": [
    {
      "id": "panel",
      "width": 1040,
      "height": 760,
      "placement": "attached",
      "shortcuts": [
        { "key": "j", "node": "calendar-next-event" },
        { "key": "k", "node": "calendar-previous-event" },
        { "key": "t", "node": "cal-today" },
        { "key": "home", "node": "cal-today" },
        { "key": "c", "node": "action-copy" },
        { "key": "r", "modifiers": ["ctrl"], "node": "cal-retry" }
      ]
    }
  ],
  "settings": [
    {
      "key": "week_start",
      "type": "select",
      "label": "Week starts on",
      "default": "monday",
      "options": [
        {
          "value": "monday",
          "label": "Monday"
        },
        {
          "value": "sunday",
          "label": "Sunday"
        }
      ]
    }
  ]
}
