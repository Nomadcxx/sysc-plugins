{
  "schema": 1,
  "id": "org.sysc.mini-docker",
  "name": "Mini Docker",
  "version": "0.4.0",
  "protocol": {
    "major": 1,
    "minor": 4
  },
  "exec": "bin/sysc-plugin-mini-docker",
  "capabilities": [
    "panels",
    "settings"
  ],
  "requires": {
    "commands": [
      "docker"
    ]
  },
  "services": [
    {
      "id": "mini-docker"
    }
  ],
  "widgets": [
    {
      "id": "bar",
      "settings": []
    }
  ],
  "panels": [
    {
      "id": "panel",
      "width": 480,
      "height": 560,
      "placement": "attached"
    }
  ],
  "settings": [
    {
      "key": "refresh_interval_seconds",
      "type": "int",
      "label": "Refresh interval (s)",
      "default": 5,
      "min": 1,
      "max": 30
    },
    {
      "key": "status_mode",
      "type": "select",
      "label": "Bar count mode",
      "default": "always",
      "options": [
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "running_only",
          "label": "When running"
        },
        {
          "value": "hidden",
          "label": "Never"
        }
      ]
    },
    {
      "key": "default_network",
      "type": "string",
      "label": "Default network",
      "default": "bridge"
    }
  ]
}
